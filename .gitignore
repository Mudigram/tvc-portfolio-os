# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the documented template must always be committable. `.env*` above
# matches `.env.example`, so without this negation a new developer cloning the
# repo gets no hint of which variables exist.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI state — machine-local, regenerated by `supabase link`/`db pull`.
# Was previously committed, including pooler-url and project-ref.
.temp/
supabase/.temp/

# Duplicate tree created by running the supabase CLI from inside src/. Never valid.
src/supabase/

# Local diagnostic scripts. Not application code, not reviewed, and they connect
# to the live database with the secret key. Keep them out of the repo.
scratch/

