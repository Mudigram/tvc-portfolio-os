# TVC Portfolio OS — environment template
# Copy to .env and fill in. Never commit a populated .env.
#
# Every variable below is one the code actually reads. To re-derive this list:
#   npx tsx -e "..."  or simply:  grep -rn "process.env\." src
#
# Naming note: this project reads NEXT_PUBLIC_SUPABASE_ANON_KEY, *not*
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. Build_Context.md previously named the
# latter; that was corrected. If you have a publishable key (sb_publishable_...)
# put that value in ANON_KEY — the variable name is legacy, the value is not.

# --- Supabase: browser/anon identity (required) -----------------------------
# Public project URL. Trailing slash is stripped where it matters.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The non-privileged key. Safe for the browser: it only grants what Row Level
# Security allows, and RLS is what enforces angel/founder isolation.
#
# IMPORTANT: because this key is client-reachable, a table with RLS *enabled*
# but no policy is readable by nobody — that is the intended posture. See
# ARCHITECTURE.md "Row Level Security" for the two documented bypasses.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Supabase: service role (required for the server security path) ---------
# Bypasses Row Level Security entirely. Server-side only. Must never be
# prefixed with NEXT_PUBLIC_ — a single stray import would ship it to browsers.
#
# Used by createServiceRoleClient() for auth-then-fetch server actions and for
# writes that RLS policy gaps currently force through the service role.
# src/lib/supabase/service.ts also accepts SUPABASE_SERVICE_ROLE_KEY and
# SUPABASE_SERVICE_KEY as aliases; SUPABASE_SECRET_KEY is the one to use.
SUPABASE_SECRET_KEY=your-service-role-key

# Optional, and the ONLY sanctioned escape hatch for the above. Set to "false"
# only after every dead RLS policy is repaired and verified — see the comment
# block at the top of src/lib/supabase/service.ts.
# RLS_BYPASS_STILL_REQUIRED=true

# --- Transactional email (optional) -----------------------------------------
# Without it, reminder and campaign actions return a clear "not configured"
# result instead of throwing.
RESEND_API_KEY=re_your_resend_key
